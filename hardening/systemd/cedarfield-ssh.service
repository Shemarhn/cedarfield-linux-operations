[Unit]
Description=Dedicated Cedarfield lab SSH access
Requires=cedarfield-network.service
After=network.target cedarfield-network.service

[Service]
NetworkNamespacePath=/run/netns/cedarfield
RuntimeDirectory=sshd
RuntimeDirectoryMode=0755
ExecStartPre=/usr/sbin/sshd -t -f /etc/cedarfield/sshd_config
ExecStart=/usr/sbin/sshd -D -e -f /etc/cedarfield/sshd_config
Restart=on-failure

[Install]
WantedBy=multi-user.target
